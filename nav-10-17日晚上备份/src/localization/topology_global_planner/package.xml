<?xml version="1.0"?>
<package format="3">
  <name>topology_global_planner</name>
  <version>0.2.0</version>
  <description>Region-Connector wrapper over tdt YAstar and MinimumSnap for the standalone navigation executor.</description>
  <maintainer email="todo@example.com">origin_nav</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>map_server</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>

  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <!-- OSQP/OsqpEigen are provided by tdt-nav-kit/3rd/install; no rosdep key exists. -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
